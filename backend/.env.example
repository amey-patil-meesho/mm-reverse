# Copy to .env (gitignored) and fill in. Only METABASE_API_KEY is required for auto-pull.

# --- Metabase auto-pull (removes the manual CSV upload) ---
METABASE_URL=https://metabase-main.bi.meeshogcp.in
# Create a Metabase API key (Account settings → API keys) and paste it here. Never commit it.
METABASE_API_KEY=
# Alternatively, a raw Metabase session token instead of an API key:
# METABASE_SESSION=
# Saved question/card id behind the shared query URL:
METABASE_CARD_ID=190711
# Pull window = trailing N days ending today:
REFRESH_DAYS=7
# Auto-refresh cadence in minutes (0 = off; 1440 = once a day):
REFRESH_INTERVAL_MIN=1440
# Startup pull mode: merge (additive, safe) or rebuild (wipe + reload):
STARTUP_PULL_MODE=merge

# If Node rejects the TLS cert behind the corporate proxy (Netskope), point it at the CA bundle:
# NODE_EXTRA_CA_CERTS=../corporate-ca.crt

# --- Google Sheet handoff (received crates + a separate MM-rider-scan sub-sheet) ---
# Create a Google service account, download its JSON key, and SHARE the target sheet with the
# service account's client_email as Editor. Then set:
GSHEET_ID=
GOOGLE_SA_KEY_FILE=./service-account.json
# (or inline instead of the file:)
# GOOGLE_SA_CLIENT_EMAIL=
# GOOGLE_SA_PRIVATE_KEY=
# Tab names (defaults shown):
# GSHEET_RECEIVED_TAB=Received at PC
# GSHEET_SCANS_TAB=MM Rider Scans

# --- Admin (data downloads / ops are admin-only) ---
# The access code you share over mail with authorised Meesho admins. If unset, one is generated
# at boot and printed in the server log. Pin it here so it survives restarts.
ADMIN_ACCESS_CODE=
# Only emails on this domain may log in as admin:
ADMIN_EMAIL_DOMAIN=@meesho.com
# Optional: restrict further to a specific allowlist (comma-separated). Blank = any @meesho.com email.
# ADMIN_EMAILS=amey.patil1@meesho.com

# --- app knobs ---
# CRATE_CAPACITY=25
# CLEARANCE_DAYS=4
# DEMO_DATE=2026-09-08
# Override the placeholder rider identity (all PPs are tagged to this until a real mapping exists):
# RIDER_NAME=Amey
# RIDER_PHONE=9999999999
